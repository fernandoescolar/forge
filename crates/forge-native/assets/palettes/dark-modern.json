// Dark Modern (VS Code's default dark theme) as a Forge palette.
// Sources: vscode/extensions/theme-defaults/themes/dark_modern.json, dark_plus.json, dark_vs.json.
// Terminal colours are VS Code's default dark ANSI set (terminal.ansi* in the workbench).
{
  "name": "Dark Modern",
  "appearance": "dark",
  "ui": {
    "window": "#181818",
    "editor": "#1f1f1f",
    "surface": "#313131",
    "border": "#2b2b2b",
    "text": "#cccccc",
    "muted": "#9d9d9d",
    "faint": "#6e7681",
    "accent": "#0078d4",
    "selection": "#264f78",
    "active_line": "#282828",
    "error": "#f85149",
    "warning": "#cca700",
    "success": "#2ea043",
    "info": "#3794ff"
  },
  "syntax": {
    "keyword": "#569cd6",
    "keyword.control": "#c586c0",
    "operator": "#d4d4d4",
    "preproc": "#569cd6",
    "tag": "#569cd6",
    "function": "#dcdcaa",
    "attribute": "#9cdcfe",
    "type": "#4ec9b0",
    "constructor": "#4ec9b0",
    "enum": "#4ec9b0",
    "namespace": "#4ec9b0",
    "label": "#c8c8c8",
    "variant": "#4fc1ff",
    "string": "#ce9178",
    "string.escape": "#d7ba7d",
    "string.regex": "#d16969",
    "string.special.symbol": "#9cdcfe",
    "number": "#b5cea8",
    "boolean": "#569cd6",
    "constant": "#4fc1ff",
    "comment": "#6a9955",
    "comment.doc": "#6a9955",
    "variable": "#9cdcfe",
    "variable.special": "#569cd6",
    "property": "#9cdcfe",
    "punctuation": "#cccccc",
    "punctuation.special": "#569cd6",
    "punctuation.list_marker": "#6796e6",
    "title": { "color": "#569cd6", "font_weight": 700 },
    "link_uri": "#4daafc",
    "link_text": "#4daafc",
    "text.literal": "#ce9178",
    "emphasis": { "color": "#c586c0", "font_style": "italic" },
    "emphasis.strong": { "color": "#569cd6", "font_weight": 700 },
    "diff.plus": "#2ea043",
    "diff.minus": "#f85149"
  },
  "terminal": {
    "black": "#000000",
    "red": "#cd3131",
    "green": "#0dbc79",
    "yellow": "#e5e510",
    "blue": "#2472c8",
    "magenta": "#bc3fbc",
    "cyan": "#11a8cd",
    "white": "#e5e5e5"
  },
  "overrides": {
    "elevated_surface.background": "#202020",
    "editor.indent_guide": "#404040",
    "editor.indent_guide_active": "#707070",
    "version_control.modified": "#0078d4",
    "modified": "#0078d4",
    "search.match_background": "#9e6a0366",
    "search.active_match_background": "#9e6a03",
    "link_text.hover": "#4daafc"
  }
}
