+
+    /// Shows the sessions' consoles outside the panel (see `active_console`), or back in
+    /// their sessions' panes.
+    pub fn set_console_elsewhere(
+        &mut self,
+        elsewhere: bool,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) {
+        self.console_elsewhere = elsewhere;
+        let running_states: Vec<_> = self
+            .sessions_with_children
+            .keys()
+            .map(|session| session.read(cx).running_state().clone())
+            .collect();
+        for running in running_states {
+            running.update(cx, |running, cx| {
+                if elsewhere {
+                    running.remove_pane_item(DebuggerPaneItem::Console, window, cx);
+                } else {
+                    running.ensure_pane_item(DebuggerPaneItem::Console, window, cx);
+                }
+            });
+        }
+        cx.notify();
+    }
+
+    /// The active session's console, to show outside the panel.
+    pub fn active_console(&self, cx: &App) -> Option<AnyView> {
+        let running = self.active_session.as_ref()?.read(cx).running_state();
+        Some(running.read(cx).console().clone().into())
+    }

