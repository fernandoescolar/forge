+/// Where the remote server's releases come from, for an application that ships its own
+/// server instead of Zed's: see [`set_remote_server_releases`]. Without one, they come from
+/// Zed's [`AutoUpdater`].
+pub trait RemoteServerReleases: Send + Sync {
+    /// A URL the remote host can download the compressed server from, or `None` to have the
+    /// client download it and upload it.
+    fn download_url(
+        &self,
+        platform: RemotePlatform,
+        release_channel: ReleaseChannel,
+        version: Option<Version>,
+        cx: &mut AsyncApp,
+    ) -> Task<Result<Option<String>>>;
+
+    /// Downloads the compressed server to this machine and returns its path.
+    fn download_locally(
+        &self,
+        platform: RemotePlatform,
+        release_channel: ReleaseChannel,
+        version: Option<Version>,
+        set_status: Box<dyn Fn(&str, &mut AsyncApp) + Send>,
+        cx: &mut AsyncApp,
+    ) -> Task<Result<PathBuf>>;
+}
+
+struct GlobalRemoteServerReleases(Arc<dyn RemoteServerReleases>);
+
+impl gpui::Global for GlobalRemoteServerReleases {}
+
+pub fn set_remote_server_releases(releases: Arc<dyn RemoteServerReleases>, cx: &mut App) {
+    cx.set_global(GlobalRemoteServerReleases(releases));
+}
+
+fn remote_server_releases(cx: &mut AsyncApp) -> Option<Arc<dyn RemoteServerReleases>> {
+    cx.update(|cx| {
+        cx.try_global::<GlobalRemoteServerReleases>()
+            .map(|releases| releases.0.clone())
+    })
+}
