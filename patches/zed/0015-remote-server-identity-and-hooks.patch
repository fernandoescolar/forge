+/// How the remote server is named on remote hosts and in a development checkout.
+/// An application other than Zed that ships its own server sets these with
+/// [`set_remote_server_names`], so that its binaries and Zed's never replace, or clean up,
+/// each other on a shared host.
+#[derive(Clone, Copy, Debug)]
+pub struct RemoteServerNames {
+    /// The directory, relative to the remote home, that holds the server binaries.
+    pub dir: &'static str,
+    /// The start of each binary's name, followed by `-<channel>-<version>`.
+    pub binary_prefix: &'static str,
+    /// The cargo package and binary that development builds compile from source.
+    pub cargo_package: &'static str,
+    pub cargo_binary: &'static str,
+}
+
+static REMOTE_SERVER_NAMES: OnceLock<RemoteServerNames> = OnceLock::new();
+
+/// Sets the names returned by [`remote_server_names`]. Call it before connecting to, or
+/// running as, a remote server. Fails, returning `names`, when they were already set.
+pub fn set_remote_server_names(names: RemoteServerNames) -> Result<(), RemoteServerNames> {
+    REMOTE_SERVER_NAMES.set(names)
+}
+
+pub fn remote_server_names() -> RemoteServerNames {
+    REMOTE_SERVER_NAMES
+        .get()
+        .copied()
+        .unwrap_or(RemoteServerNames {
+            dir: ".zed_server",
+            binary_prefix: "zed-remote-server",
+            cargo_package: "remote_server",
+            cargo_binary: "remote_server",
+        })
+}
+
 /// Returns the relative path to the zed_server directory on the ssh host.
 pub fn remote_server_dir_relative() -> &'static RelPath {
     static CACHED: LazyLock<&'static RelPath> =
-        LazyLock::new(|| RelPath::from_unix_str(".zed_server").unwrap());
+        LazyLock::new(|| RelPath::from_unix_str(remote_server_names().dir).unwrap());
     *CACHED
 }
 
