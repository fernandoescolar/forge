+    /// Sends a language server a notification that has no typed API, on this machine or on
+    /// the project's host, where [`Self::language_server_for_id`] doesn't reach.
+    pub fn notify_language_server(
+        &self,
+        id: LanguageServerId,
+        method: String,
+        params: serde_json::Value,
+        cx: &App,
+    ) -> Task<Result<()>> {
+        if let Some((client, project_id)) = self.upstream_client() {
+            let request = client.request(proto::NotifyLanguageServer {
+                project_id,
+                language_server_id: id.to_proto(),
+                method,
+                params: params.to_string(),
+            });
+            return cx.background_spawn(async move {
+                request.await?;
+                Ok(())
+            });
+        }
+        Task::ready(self.notify_local_language_server(id, method, params))
+    }
+
+    /// How a language server's process ended, if it has: on this machine or on the project's
+    /// host, where [`Self::language_server_for_id`] doesn't reach.
+    pub fn language_server_exit_status(
+        &self,
+        id: LanguageServerId,
+        cx: &App,
+    ) -> Task<Result<Option<String>>> {
+        if let Some((client, project_id)) = self.upstream_client() {
+            let request = client.request(proto::GetLanguageServerExitStatus {
+                project_id,
+                language_server_id: id.to_proto(),
+            });
+            return cx.background_spawn(async move { Ok(request.await?.status) });
+        }
+        Task::ready(Ok(self.local_language_server_exit_status(id)))
+    }
+
+    fn notify_local_language_server(
+        &self,
+        id: LanguageServerId,
+        method: String,
+        params: serde_json::Value,
+    ) -> Result<()> {
+        self.language_server_for_id(id)
+            .with_context(|| format!("no running language server {id}"))?
+            .notify_raw(method, params)
+    }
+
+    fn local_language_server_exit_status(&self, id: LanguageServerId) -> Option<String> {
+        let status = self.language_server_for_id(id)?.exit_status()?;
+        Some(status.to_string())
+    }
+
+    async fn handle_notify_language_server(
+        this: Entity<Self>,
+        envelope: TypedEnvelope<proto::NotifyLanguageServer>,
+        cx: AsyncApp,
+    ) -> Result<proto::Ack> {
+        let id = LanguageServerId::from_proto(envelope.payload.language_server_id);
+        let params = serde_json::from_str(&envelope.payload.params)
+            .context("reading the notification's parameters")?;
+        this.read_with(&cx, |lsp_store, _| {
+            lsp_store.notify_local_language_server(id, envelope.payload.method, params)
+        })?;
+        Ok(proto::Ack {})
+    }
+
+    async fn handle_get_language_server_exit_status(
+        this: Entity<Self>,
+        envelope: TypedEnvelope<proto::GetLanguageServerExitStatus>,
+        cx: AsyncApp,
+    ) -> Result<proto::GetLanguageServerExitStatusResponse> {
+        let id = LanguageServerId::from_proto(envelope.payload.language_server_id);
+        let status = this.read_with(&cx, |lsp_store, _| {
+            lsp_store.local_language_server_exit_status(id)
+        });
+        Ok(proto::GetLanguageServerExitStatusResponse { status })
+    }
