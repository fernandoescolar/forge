+            serde_json::to_string(&Notification {
+                jsonrpc: JSON_RPC_VERSION,
+                method: &method,
+                params,
+            })
+            .unwrap()
+        }));
+        self.outbound_tx.send_blocking(message)?;
+        Ok(())
+    }
