+    /// Groups of panels shown together (in this dock, in order): when one of them is
+    /// activated, the dock shows all of them, split along the dock.
+    pub fn set_panel_groups(&mut self, groups: Vec<Vec<EntityId>>, window: &mut Window, cx: &mut Context<Self>) {
