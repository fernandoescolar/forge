+    pub fn panel_weights(&self) -> &std::collections::HashMap<EntityId, f32> {
+        &self.panel_weights
+    }
+
+    pub fn set_panel_weights(&mut self, weights: std::collections::HashMap<EntityId, f32>, cx: &mut Context<Self>) {
+        if self.panel_weights != weights {
+            self.panel_weights = weights;
+            cx.notify();
+        }
+    }
+
+    fn panel_weight(&self, id: EntityId) -> f32 {
+        self.panel_weights.get(&id).copied().unwrap_or(1.0)
+    }
+
+    /// Moves the divider before `index` in the group `ids` to `fraction` of the group's
+    /// length, between the two panels it separates (each keeps a minimum).
+    fn resize_group(&mut self, ids: &[EntityId], index: usize, fraction: f32, cx: &mut Context<Self>) {
+        const MIN: f32 = 0.06;
+        if index == 0 || index >= ids.len() {
+            return;
+        }
+        let weights: Vec<f32> = ids.iter().map(|id| self.panel_weight(*id)).collect();
+        let total: f32 = weights.iter().sum();
+        let before: f32 = weights[..index - 1].iter().sum();
+        let through: f32 = weights[..=index].iter().sum();
+        let boundary = (fraction * total).clamp(before + MIN * total, through - MIN * total);
+        if before + MIN * total > through - MIN * total {
+            return;
+        }
+        self.panel_weights.insert(ids[index - 1], boundary - before);
+        self.panel_weights.insert(ids[index], through - boundary);
+        cx.notify();
+    }
+
+    fn reset_group_weights(&mut self, ids: &[EntityId], cx: &mut Context<Self>) {
+        for id in ids {
+            self.panel_weights.remove(id);
+        }
+        cx.notify();
+    }
+
