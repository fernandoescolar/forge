+    /// Adds a source of code actions (shown with the language servers' in the code actions
+    /// menu); one with the same `id` is replaced.
+    pub fn push_code_action_provider(
+        &mut self,
+        provider: Rc<dyn CodeActionProvider>,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) {
+        let id = provider.id();
+        self.code_action_providers.retain(|p| p.id() != id);
+        self.code_action_providers.push(provider);
+        self.refresh_code_actions_for_selection(window, cx);
+    }
+
