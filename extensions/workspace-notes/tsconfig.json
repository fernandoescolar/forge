{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2022"],
    "typeRoots": ["../../packages/forge-api/node_modules/@types"],
    "paths": {
      "@forge-ide/api": ["../../packages/forge-api/src/index.ts"],
      "react": ["../../packages/forge-api/node_modules/@types/react"],
      "react/jsx-runtime": ["../../packages/forge-api/node_modules/@types/react/jsx-runtime"]
    }
  },
  "include": ["src", "../../packages/forge-api/src/globals.d.ts"]
}
